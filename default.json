{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommitsDisabled",
    ":label(dependencies)",
    ":enableVulnerabilityAlerts",
    ":disableRateLimiting"
  ],
  "timezone": "America/Detroit",
  "reviewers": ["team:maintainers"],
  "cargo": {
    "automerge": true,
    "schedule": ["* 17-23 * * 3"]
  },
  "github-actions": {
    "automerge": true,
    "schedule": ["* 17-23 * * 3"]
  },
  "lockFileMaintenance": {
    "description": "Automate lockfile maintenence quarterly.",
    "enabled": true,
    "automerge": true,
    "schedule": ["* 17-23 21 */3 *"]
    },
  "pep621": {
    "automerge": true,
    "schedule": ["* 17-23 * * 3"]
  },
  "pip-compile": {
    "managerFilePatterns": ["/.*requirements.*\\.(txt|pip)$/"],
    "automerge": true
  },
  "pip_requirements": {
    "enabled": false
  },
  "pip_setup": {
    "enabled": false
  },
  "poetry": {
    "enabled": false
  },
  "packageRules": [
    {
      "matchManagers": ["pixi"],
      "matchPackageNames": ["python", "libpython"],
      "groupName": "python"
    }
  ]
}
