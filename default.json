{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommitsDisabled",
    ":label(dependencies)",
    ":enableVulnerabilityAlerts"
  ],
  "schedule": ["* * * * 1"],
  "timezone": "America/Detroit",
  "reviewers": ["team:maintainers"],
  "cargo": {
    "automerge": true
  },
  "github-actions": {
    "automerge": true
  },
  "lockFileMaintenance": {
    "description": "Automate lockfile maintenence quarterly.",
    "enabled": true,
    "automerge": true,
    "schedule": ["* * 20 */3 *"]
    },
  "pip-compile": {
    "managerFilePatterns": ["/.*requirements.*\\.(txt|pip)$/"],
    "automerge": true
  },
  "pip_requirements": {
    "enabled": false
  },
  "pip_setup": {
    "enabled": false
  },
  "poetry": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Enable lookups for indirect lockfile dependencies",
      "enabled": true,
      "matchDepTypes": [
        "indirect"
      ]
    },
    {
      "description": "Disable non-security updates for indirect dependencies (vulnerability alerts use force to override this)",
      "enabled": false,
      "matchDepTypes": [
        "indirect"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest",
        "lockFileMaintenance",
        "rollback",
        "replacement"
      ]
    }
  ]
}
