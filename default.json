{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "schedule:monthly",
    ":semanticCommitsDisabled",
    ":label(dependencies)"
  ],
  "timezone": "America/Detroit",
  "reviewers": ["team:maintainers"],
  "cargo": {
    "automerge": false
  },
  "github-actions": {
    "automerge": false
  },
  "lockFileMaintenance": {
    "description": "Automate lockfile maintenence quarterly.",
    "enabled": true,
    "automerge": false,
    "schedule": ["* * 20 */3 *"]
    },
  "pip-compile": {
    "managerFilePatterns": ["/.*requirements.*\\.(txt|pip)$/"],
    "automerge": false
  },
  "pip_requirements": {
    "enabled": false
  },
  "pip_setup": {
    "enabled": false
  },
  "poetry": {
    "enabled": false
  }
}
