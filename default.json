{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommitsDisabled",
    ":label(dependencies)"
  ],
  "timezone": "America/Detroit",
  "reviewers": ["team:maintainers"],
  "cargo": {
    "automerge": true
  },
  "github-actions": {
    "automerge": true
  },
  "lockFileMaintenance": {
    "description": "Automate lockfile maintenence early on Thursdays.",
    "enabled": true,
    "automerge": true,
    "schedule": ["* 0-3 * * 4"]
    },
  "pip-compile": {
    "managerFilePatterns": ["/.*requirements.*\\.(txt|pip)$/"],
    "automerge": true
  },
  "pip_requirements": {
    "enabled": false
  },
  "pip_setup": {
    "enabled": false
  },
  "poetry": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Do not upgrade pinned python versions used for testing.",
      "matchManagers": ["pixi"],
      "matchDepTypes": ["feature-py*"],
      "matchPackageNames": ["python"],
      "enabled": false
    }
  ]
}
